__pycache__/
*.py[cod]
.pytest_cache/

# Training + diagnostics artefacts (evidence lives under docs/)
# runs/ contains checkpoints, metrics.jsonl, and per-checkpoint diagnostics
# reports. The docs/e5_evidence.json is the durable, machine-readable summary
# used for certification. runs/ contents are ephemeral and rebuildable by
# re-running scripts/e5_certify.py or scripts/train.py.
runs/
tokenizer/

# CORPUS-1/CORPUS-2: deterministic preprocessing output.
# Every processed/*.jsonl is derivable from the committed source bytes
# under research-data/AEON-LBC-1/source/ plus the fixed preprocessing
# script + preprocessing_version. Not committed to preserve sealed-test
# discipline on PG-1661 (Sherlock Holmes) — the test partition text
# must not leave the local machine.
research-data/AEON-LBC-1/processed/
research-data/AEON-LBC-1/tokenizer/

# EN-DOLLY-15K corpus: raw upload under research-data/incoming/EN-DOLLY-15K/
# is CC BY-SA 3.0 (share-alike). Per ENGLISH-PROOF-0 directive §5 and the
# corpus intake contract, the raw acquisition is NOT committed to the
# repository; its digest, size, license, and provenance live in
# docs/en_train/dolly15k_provenance.json and the split partition ids
# (record_id only, no text) live in docs/en_train/dolly15k_split_manifest.json.
research-data/incoming/EN-DOLLY-15K/

# DESKTOP-1: release-assets/ contains reproducible export bundles
# (model state_dict + manifests + tokenizer copy). Regenerated by
# scripts/export_aeon_desktop_model.py from the committed checkpoint
# + tokenizer + config. Not committed.
release-assets/
