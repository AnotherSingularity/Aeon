{
  "schema_version": 1,
  "notes": "Directive-mandated initial barrier definitions. All metrics operate on visible external-evaluator data only. Thresholds land as null and are calibrated by aeon.bypass.barriers.BarrierRegistry.calibrate() on the calibration partition, then LOCK. Post-hoc threshold change invalidates the L-series claim ladder.",
  "barriers": [
    {
      "schema_version": 1,
      "barrier_id": "HIGH_LOCAL_LOSS",
      "version": 1,
      "description": "The pre-broadcast token loss is in the top 5% of the calibration distribution — a position where the model's visible-only computation is uncertain about the next token.",
      "visible_metric": "pre_broadcast_token_loss",
      "observation_point": "pre_broadcast",
      "threshold_method": "top_percent",
      "threshold_value": null,
      "calibration_partition": "calibration",
      "evaluation_partition": "test",
      "minimum_samples": 200,
      "missing_data_action": "false",
      "applicable_tasks": ["long_entity_recall", "delayed_instruction", "pronoun_resolution", "nested_dependency", "contradiction_resolution", "state_tracking", "local_aliasing", "long_negation"]
    },
    {
      "schema_version": 1,
      "barrier_id": "LOW_TARGET_MARGIN",
      "version": 1,
      "description": "The pre-broadcast correct-token margin is in the bottom 5% — the model does not clearly prefer the true continuation over its runners-up.",
      "visible_metric": "pre_broadcast_correct_token_margin",
      "observation_point": "pre_broadcast",
      "threshold_method": "bottom_percent",
      "threshold_value": null,
      "calibration_partition": "calibration",
      "evaluation_partition": "test",
      "minimum_samples": 200,
      "missing_data_action": "false",
      "applicable_tasks": ["long_entity_recall", "delayed_instruction", "pronoun_resolution", "nested_dependency"]
    },
    {
      "schema_version": 1,
      "barrier_id": "HIGH_VISIBLE_ENTROPY",
      "version": 1,
      "description": "The pre-broadcast output-distribution entropy is in the top 5%; the model's visible-only computation is spreading probability mass widely.",
      "visible_metric": "pre_broadcast_output_entropy",
      "observation_point": "pre_broadcast",
      "threshold_method": "top_percent",
      "threshold_value": null,
      "calibration_partition": "calibration",
      "evaluation_partition": "test",
      "minimum_samples": 200,
      "missing_data_action": "false",
      "applicable_tasks": ["contradiction_resolution", "state_tracking", "local_aliasing", "long_negation"]
    },
    {
      "schema_version": 1,
      "barrier_id": "LONG_DEPENDENCY",
      "version": 1,
      "description": "The task's dependency distance (tokens between the barrier position and the earliest evidence required for the correct answer) is at least the 90th-percentile of the calibration distribution.",
      "visible_metric": "dependency_distance",
      "observation_point": "task_level",
      "threshold_method": "per_partition_quantile",
      "threshold_value": null,
      "calibration_partition": "calibration",
      "evaluation_partition": "test",
      "minimum_samples": 200,
      "missing_data_action": "false",
      "applicable_tasks": ["long_entity_recall", "nested_dependency", "long_negation"]
    },
    {
      "schema_version": 1,
      "barrier_id": "LOCAL_STATE_ALIASING",
      "version": 1,
      "description": "The local suffix (last N tokens) exactly matches a previously observed context that required a different continuation. High local-state repetition score.",
      "visible_metric": "local_state_repetition",
      "observation_point": "pre_broadcast",
      "threshold_method": "top_percent",
      "threshold_value": null,
      "calibration_partition": "calibration",
      "evaluation_partition": "test",
      "minimum_samples": 200,
      "missing_data_action": "false",
      "applicable_tasks": ["local_aliasing", "pronoun_resolution"]
    },
    {
      "schema_version": 1,
      "barrier_id": "CONTRADICTION_REGION",
      "version": 1,
      "description": "The task labels this position as inside a contradiction span (an earlier assertion has been visibly contradicted and the correct continuation depends on knowing which assertion holds).",
      "visible_metric": "visible_failure_to_resolve_task_state",
      "observation_point": "task_level",
      "threshold_method": "median",
      "threshold_value": null,
      "calibration_partition": "calibration",
      "evaluation_partition": "test",
      "minimum_samples": 200,
      "missing_data_action": "false",
      "applicable_tasks": ["contradiction_resolution"]
    },
    {
      "schema_version": 1,
      "barrier_id": "DELAYED_INSTRUCTION_REGION",
      "version": 1,
      "description": "The task labels this position as requiring an instruction issued at least ``dependency_distance`` tokens earlier to be applied. The visible-only model must recall the instruction from earlier context.",
      "visible_metric": "dependency_distance",
      "observation_point": "task_level",
      "threshold_method": "per_partition_quantile",
      "threshold_value": null,
      "calibration_partition": "calibration",
      "evaluation_partition": "test",
      "minimum_samples": 200,
      "missing_data_action": "false",
      "applicable_tasks": ["delayed_instruction"]
    },
    {
      "schema_version": 1,
      "barrier_id": "ENTITY_STATE_DISCONTINUITY",
      "version": 1,
      "description": "The task labels this position as immediately after a state transition (an entity's tracked attribute changed) that the model must reflect in its continuation.",
      "visible_metric": "visible_prediction_instability",
      "observation_point": "task_level",
      "threshold_method": "top_percent",
      "threshold_value": null,
      "calibration_partition": "calibration",
      "evaluation_partition": "test",
      "minimum_samples": 200,
      "missing_data_action": "false",
      "applicable_tasks": ["state_tracking"]
    }
  ]
}
